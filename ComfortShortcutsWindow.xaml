                            <!-- ACTION TYPE 3: PASTE TEXT (Đợt 4 & Gợi ý 11, 12, 13) -->
                            <Grid x:Name="PanelPasteText" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Action type : Paste text" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource CyberNeonCyan}" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="1" Text="Text (hỗ trợ các thẻ động &lt;DATE&gt;, &lt;INPUT:...&gt;, &lt;CURSOR&gt;):" FontFamily="Consolas" Foreground="{StaticResource CyberTextSecondary}" Margin="0,0,0,4" />

                                <TextBox x:Name="TxtPasteContent" Grid.Row="2" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Padding="6" Background="{StaticResource CyberInput}" Foreground="{StaticResource CyberTextPrimary}" BorderBrush="{StaticResource CyberBorderDim}" TextChanged="TxtPasteContent_TextChanged" Margin="0,0,0,8" />

                                <StackPanel Grid.Row="3" Margin="0,0,0,8">
                                    <CheckBox x:Name="ChkShowTextOnKeyboard" Content="Show text on the on-screen keyboard" FontFamily="Consolas" Margin="0,0,0,4" Checked="ChkShowTextOnKeyboard_Changed" Unchecked="ChkShowTextOnKeyboard_Changed" />
                                    <CheckBox x:Name="ChkPasteAsPlainText" Content="Paste as plain text (Dán văn bản thuần, loại bỏ format rườm rà)" FontFamily="Consolas" Foreground="{StaticResource CyberNeonYellow}" Checked="ChkPasteAsPlainText_Changed" Unchecked="ChkPasteAsPlainText_Changed" />
                                </StackPanel>

                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Insert Tag:" VerticalAlignment="Center" FontFamily="Consolas" Foreground="{StaticResource CyberTextSecondary}" Margin="0,0,8,0" />
                                    <ComboBox x:Name="CmbInsertTag" Grid.Column="1" HorizontalAlignment="Left" Width="330" Height="26" FontFamily="Consolas" SelectionChanged="CmbInsertTag_SelectionChanged">
                                        <ComboBoxItem Content="🪄 Select Tag to Insert..." IsSelected="True" />
                                        <ComboBoxItem Content="💬 Tag: &lt;INPUT: Nhập họ tên&gt; (Hộp thoại Cyberpunk)" Tag="&lt;INPUT: Nhập thông tin&gt;" />
                                        <ComboBoxItem Content="📍 Tag: &lt;CURSOR&gt; (Vị trí con trỏ sau khi dán)" Tag="&lt;CURSOR&gt;" />
                                        <ComboBoxItem Content="📅 Date: Long Default" Tag="&lt;DATE_LONG&gt;" />
                                        <ComboBoxItem Content="📅 Date: Short Default [date]" Tag="{}{date}" />
                                        <ComboBoxItem Content="📅 Date: mm/dd/yyyy" Tag="&lt;DATE_MM_DD_YYYY&gt;" />
                                        <ComboBoxItem Content="📅 Date: dd.mm.yyyy" Tag="&lt;DATE_DD_MM_YYYY&gt;" />
                                        <ComboBoxItem Content="⏰ Time: Default [time]" Tag="{}{time}" />
                                        <ComboBoxItem Content="⏰ Time: 24h (HH:mm)" Tag="&lt;TIME_HH_MM_24&gt;" />
                                        <ComboBoxItem Content="⏰ Time: 12h (hh:mm tt)" Tag="&lt;TIME_HH_MM_12&gt;" />
                                        <ComboBoxItem Content="⏰ Time: Millis (HH:mm:ss.fff)" Tag="&lt;TIME_MILLIS&gt;" />
                                        <ComboBoxItem Content="📆 Date &amp; Time: Long Format" Tag="&lt;DATETIME_LONG&gt;" />
                                        <ComboBoxItem Content="📆 Date &amp; Time: Short Format" Tag="&lt;DATETIME_SHORT&gt;" />
                                        <ComboBoxItem Content="📋 Paste Clipboard [clipboard]" Tag="{}{clipboard}" />
                                        <ComboBoxItem Content="🎲 Tag: &lt;SomeOf: Option 1 | Option 2&gt;" Tag="&lt;SomeOf: Lựa chọn 1 | Lựa chọn 2&gt;" />
                                        <ComboBoxItem Content="💬 Tag: &lt;POPUP: Title&gt;" Tag="&lt;POPUP: Tiêu đề&gt;" />
                                        <ComboBoxItem Content="⌨ Key: Tab (&lt;KEY_TAB&gt;)" Tag="&lt;KEY_TAB&gt;" />
                                        <ComboBoxItem Content="⌨ Key: Enter (&lt;KEY_ENTER&gt;)" Tag="&lt;KEY_ENTER&gt;" />
                                        <ComboBoxItem Content="⌨ Key: Ctrl+Enter (&lt;KEY_CTRL_ENTER&gt;)" Tag="&lt;KEY_CTRL_ENTER&gt;" />
                                        <ComboBoxItem Content="⌨ Key: Backspace (&lt;KEY_BACKSPACE&gt;)" Tag="&lt;KEY_BACKSPACE&gt;" />
                                        <ComboBoxItem Content="⌨ Key: Delete (&lt;KEY_DEL&gt;)" Tag="&lt;KEY_DEL&gt;" />
                                        <ComboBoxItem Content="⌨ Key: Space (&lt;KEY_SPACE&gt;)" Tag="&lt;KEY_SPACE&gt;" />
                                    </ComboBox>
                                </Grid>
                            </Grid>

                            <!-- ACTION TYPE 5: AUDIO CONTROL (Đợt 1) -->
                            <Grid x:Name="PanelAudioControl" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Action type : Audio control" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource CyberNeonCyan}" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="1" Text="Action:" FontFamily="Consolas" Foreground="{StaticResource CyberTextSecondary}" Margin="0,0,0,4" />

                                <ListBox x:Name="LstAudioActions" Grid.Row="2" Background="{StaticResource CyberInput}" BorderBrush="{StaticResource CyberBorderDim}" Foreground="{StaticResource CyberTextPrimary}" FontFamily="Consolas" SelectionChanged="LstAudioActions_SelectionChanged" Margin="0,0,0,10">
                                    <ListBoxItem Content="🔊 Volume up" Tag="Volume up" />
                                    <ListBoxItem Content="🔉 Volume down" Tag="Volume down" />
                                    <ListBoxItem Content="🔇 Volume on/off" Tag="Volume on/off" />
                                    <ListBoxItem Content="⏏ Eject/Close CD door" Tag="Eject/Close CD door" />
                                    <ListBoxItem Content="🎧 Change the default playback device" Tag="Change the default playback device" />
                                    <ListBoxItem Content="🎙 Change the default recording device" Tag="Change the default recording device" />
                                </ListBox>

                                <Grid x:Name="PanelAudioStepSize" Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Step size:" VerticalAlignment="Center" FontFamily="Consolas" Foreground="{StaticResource CyberTextSecondary}" Margin="0,0,10,0" />
                                    <Slider x:Name="SldAudioStepSize" Grid.Column="1" Minimum="1" Maximum="50" Value="5" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center" ValueChanged="SldAudioStepSize_ValueChanged" />
                                    <TextBlock x:Name="TxtAudioStepVal" Grid.Column="2" Text="5%" VerticalAlignment="Center" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource CyberNeonCyan}" Margin="10,0,0,0" />
                                </Grid>
                            </Grid>

                            <!-- ACTION TYPE: BLOCK KEY OR SHORTCUT (Chuẩn Comfort Keys Pro) -->
                            <Grid x:Name="PanelBlockKey" Visibility="Collapsed">
                                <StackPanel Margin="0,5,0,0">
                                    <TextBlock Text="Action type : Block key or shortcut" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource CyberNeonCyan}" Margin="0,0,0,12" FontSize="13" />

                                    <Border Background="#1A0D15" BorderBrush="{StaticResource CyberNeonPink}" BorderThickness="1" CornerRadius="3" Padding="14,12" Margin="0,0,0,15">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                <TextBlock Text="🚫" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Phím hoặc tổ hợp phím này sẽ bị CHẶN HOÀN TOÀN" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource CyberNeonPink}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="Khi nhấn phím này trên bàn phím, tín hiệu sẽ bị nuốt ngay tại tầng Keyboard Hook cấp thấp của Windows. Hệ điều hành và các ứng dụng khác sẽ không nhận được phím."
                                                       FontFamily="Consolas, Segoe UI" Foreground="{StaticResource CyberTextPrimary}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,6" />
                                            <TextBlock Text="• Phù hợp để vô hiệu hóa phím Start Menu (LeftWin), phím CapsLock, phím Insert, hoặc phím chức năng khi chơi game."
                                                       FontFamily="Consolas, Segoe UI" Foreground="{StaticResource CyberTextSecondary}" FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- ACTION TYPE: REPLACE KEY OR SHORTCUT (Chuẩn Comfort Keys Pro) -->
                            <Grid x:Name="PanelReplaceKey" Visibility="Collapsed">
                                <StackPanel Margin="0,5,0,0">
                                    <TextBlock Text="Action type : Replace key or shortcut" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource CyberNeonCyan}" Margin="0,0,0,10" FontSize="13" />

                                    <TextBlock Text="Replace with key:" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource CyberTextPrimary}" Margin="0,0,0,5" />

                                    <ComboBox x:Name="CmbReplaceWithKey" Height="26" MaxDropDownHeight="320" FontFamily="Consolas" FontSize="12"
                                              Background="{StaticResource CyberInput}" Foreground="{StaticResource CyberTextPrimary}" BorderBrush="{StaticResource CyberBorderDim}"
                                              SelectionChanged="CmbReplaceWithKey_SelectionChanged" Margin="0,0,0,6" />

                                    <!-- Modifier Checkboxes (+) chuẩn Comfort Keys Pro -->
                                    <TextBlock Text="+" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource CyberNeonYellow}" FontSize="14" Margin="2,0,0,4" />

                                    <StackPanel Margin="6,0,0,12">
                                        <CheckBox x:Name="ChkReplaceShift" Content="Shift" FontFamily="Consolas" Margin="0,0,0,4" Checked="ReplaceModifier_Changed" Unchecked="ReplaceModifier_Changed" />
                                        <CheckBox x:Name="ChkReplaceCtrl" Content="Ctrl" FontFamily="Consolas" Margin="0,0,0,4" Checked="ReplaceModifier_Changed" Unchecked="ReplaceModifier_Changed" />
                                        <CheckBox x:Name="ChkReplaceAlt" Content="Alt" FontFamily="Consolas" Margin="0,0,0,4" Checked="ReplaceModifier_Changed" Unchecked="ReplaceModifier_Changed" />
                                        <CheckBox x:Name="ChkReplaceWin" Content="Win" FontFamily="Consolas" Margin="0,0,0,4" Checked="ReplaceModifier_Changed" Unchecked="ReplaceModifier_Changed" />
                                    </StackPanel>

                                    <Border Background="#0D1B2A" BorderBrush="{StaticResource CyberNeonCyan}" BorderThickness="1" CornerRadius="3" Padding="12,10">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="🔄" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Tự động thay thế phím hoặc tổ hợp phím (Replace with key or shortcut)" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource CyberNeonCyan}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="Khi nhấn phím hoặc tổ hợp phím gốc, ModernKey sẽ nuốt phím đó và phát ra phím thay thế kết hợp cùng các phím Shift/Ctrl/Alt/Win (nếu được chọn) tới hệ thống theo thời gian thực."
                                                       FontFamily="Consolas, Segoe UI" Foreground="{StaticResource CyberTextPrimary}" TextWrapping="Wrap" LineHeight="17" Margin="0,0,0,4" />
                                            <TextBlock Text="• Ví dụ: Thay phím Apps thành phím Win (5B - Win), hoặc gán phím tắt thay thế."
                                                       FontFamily="Consolas, Segoe UI" Foreground="{StaticResource CyberTextSecondary}" FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- ACTION TYPE: WINDOW CONTROL (Gợi ý 6) -->
                            <Grid x:Name="PanelWindowControl" Visibility="Collapsed">
                                <StackPanel Margin="0,5,0,0">
                                    <TextBlock Text="Action type : Window control" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource CyberNeonCyan}" Margin="0,0,0,10" FontSize="13" />
                                    <TextBlock Text="Hành động điều khiển cửa sổ hiện tại:" FontFamily="Consolas" Foreground="{StaticResource CyberTextSecondary}" Margin="0,0,0,4" />
                                    <ComboBox x:Name="CmbWindowAction" Height="26" FontFamily="Consolas" SelectionChanged="CmbWindowAction_SelectionChanged" Margin="0,0,0,12">
                                        <ComboBoxItem Content="❌ Đóng cửa sổ (Close Window)" Tag="CloseWindow" IsSelected="True" />
                                        <ComboBoxItem Content="📌 Ghim luôn trên cùng (Toggle Always on Top)" Tag="ToggleAlwaysOnTop" />
                                        <ComboBoxItem Content="🕵 Boss Key: Ẩn/Hiện tức thì (Toggle Boss Key Hide/Show)" Tag="BossKeyHideShow" />
                                        <ComboBoxItem Content="🗕 Thu nhỏ cửa sổ (Minimize Window)" Tag="MinimizeWindow" />
                                        <ComboBoxItem Content="👻 Chỉnh độ trong suốt (Set Transparency)" Tag="SetTransparency" />
                                        <ComboBoxItem Content="🖥 Chuyển sang màn hình tiếp theo (Move to Next Monitor)" Tag="MoveToNextMonitor" />
                                    </ComboBox>

                                    <!-- Panel độ trong suốt (chỉ hiện khi chọn SetTransparency) -->
                                    <StackPanel x:Name="PnlWindowTransparency" Visibility="Collapsed" Margin="0,0,0,12">
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Độ mờ / trong suốt (Opacity):" FontFamily="Consolas" Foreground="{StaticResource CyberTextSecondary}" />
                                            <TextBlock x:Name="TxtWindowTransparencyVal" Grid.Column="1" Text="80%" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource CyberNeonCyan}" />
                                        </Grid>
                                        <Slider x:Name="SldWindowTransparency" Minimum="10" Maximum="100" Value="80" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="SldWindowTransparency_ValueChanged" />
                                    </StackPanel>

                                    <Border Background="#0B1C28" BorderBrush="{StaticResource CyberNeonCyan}" BorderThickness="1" CornerRadius="2" Padding="10,8">
                                        <TextBlock Text="💡 Mẹo: Chức năng Ghim Always on Top và Boss Key hỗ trợ chế độ bật/tắt (Toggle) thông minh theo thời gian thực."
                                                   FontFamily="Consolas" FontSize="11" Foreground="{StaticResource CyberTextSecondary}" TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- ACTION TYPE: MONITOR CONTROL (Gợi ý 7) -->
                            <Grid x:Name="PanelMonitorControl" Visibility="Collapsed">
                                <StackPanel Margin="0,5,0,0">
                                    <TextBlock Text="Action type : Monitor control" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource CyberNeonCyan}" Margin="0,0,0,10" FontSize="13" />
                                    <TextBlock Text="Hành động điều khiển màn hình:" FontFamily="Consolas" Foreground="{StaticResource CyberTextSecondary}" Margin="0,0,0,4" />
                                    <ComboBox x:Name="CmbMonitorAction" Height="26" FontFamily="Consolas" SelectionChanged="CmbMonitorAction_SelectionChanged" Margin="0,0,0,12">
                                        <ComboBoxItem Content="💤 Tắt màn hình (Turn Off Monitor)" Tag="TurnOffMonitor" IsSelected="True" />
                                        <ComboBoxItem Content="🌌 Bật trình bảo vệ màn hình (Screen Saver)" Tag="ScreenSaver" />
                                        <ComboBoxItem Content="🔒 Khóa máy tính (Lock Workstation)" Tag="LockWorkstation" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- ACTION TYPE: SYSTEM ACTION (Gợi ý 8) -->
                            <Grid x:Name="PanelSystemAction" Visibility="Collapsed">
                                <StackPanel Margin="0,5,0,0">
                                    <TextBlock Text="Action type : System action" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource CyberNeonCyan}" Margin="0,0,0,10" FontSize="13" />
                                    <TextBlock Text="Hành động hệ thống:" FontFamily="Consolas" Foreground="{StaticResource CyberTextSecondary}" Margin="0,0,0,4" />
                                    <ComboBox x:Name="CmbSystemAction" Height="26" FontFamily="Consolas" SelectionChanged="CmbSystemAction_SelectionChanged" Margin="0,0,0,12">
                                        <ComboBoxItem Content="🌙 Ngủ (Sleep)" Tag="Sleep" IsSelected="True" />
                                        <ComboBoxItem Content="❄ Ngủ đông (Hibernate)" Tag="Hibernate" />
                                        <ComboBoxItem Content="🔄 Khởi động lại (Restart)" Tag="Restart" />
                                        <ComboBoxItem Content="⚡ Tắt máy (Shutdown)" Tag="Shutdown" />
                                        <ComboBoxItem Content="🗑 Dọn sạch thùng rác (Empty Recycle Bin)" Tag="EmptyRecycleBin" />
                                        <ComboBoxItem Content="✂ Chụp màn hình (Snipping Tool)" Tag="SnippingTool" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- ACTION TYPE: MOUSE CONTROL (Gợi ý 9) -->
                            <Grid x:Name="PanelMouseControl" Visibility="Collapsed">
                                <StackPanel Margin="0,5,0,0">
                                    <TextBlock Text="Action type : Mouse control" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource CyberNeonCyan}" Margin="0,0,0,10" FontSize="13" />
                                    <TextBlock Text="Hành động chuột mô phỏng:" FontFamily="Consolas" Foreground="{StaticResource CyberTextSecondary}" Margin="0,0,0,4" />
                                    <ComboBox x:Name="CmbMouseAction" Height="26" FontFamily="Consolas" SelectionChanged="CmbMouseAction_SelectionChanged" Margin="0,0,0,12">
                                        <ComboBoxItem Content="🖱 Nhấp chuột trái (Left Click)" Tag="LeftClick" IsSelected="True" />
                                        <ComboBoxItem Content="🖱 Nhấp chuột phải (Right Click)" Tag="RightClick" />
                                        <ComboBoxItem Content="🖱 Nhấp chuột giữa (Middle Click)" Tag="MiddleClick" />
                                        <ComboBoxItem Content="🖱 Nhấp đúp chuột trái (Double Click)" Tag="DoubleClick" />
                                        <ComboBoxItem Content="📜 Cuộn lên (Wheel Up)" Tag="WheelUp" />
                                        <ComboBoxItem Content="📜 Cuộn xuống (Wheel Down)" Tag="WheelDown" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- ACTION TYPE: KEYSTROKE MACRO (Gợi ý 10) -->
                            <Grid x:Name="PanelKeystrokeMacro" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="Action type : Keystroke macro" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource CyberNeonCyan}" Margin="0,5,0,8" FontSize="13" />

                                <!-- Record & Script Editor Action Buttons -->
                                <Grid Grid.Row="1" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnRecordMacro" Grid.Column="0" Content="🔴 Record Macro (F11/Esc)" Height="30"
                                            Background="#3A101A" BorderBrush="{StaticResource CyberNeonPink}" Foreground="{StaticResource CyberNeonPink}"
                                            Click="BtnRecordMacro_Click" ToolTip="Bắt đầu ghi thao tác chuột &amp; bàn phím thời gian thực. Nhấn [F11] hoặc [Esc] để dừng ghi." />
                                    <Button x:Name="BtnOpenScriptEditor" Grid.Column="2" Content="📝 Script Editor..." Height="30"
                                            Background="#0C263A" BorderBrush="{StaticResource CyberNeonCyan}" Foreground="{StaticResource CyberNeonCyan}"
                                            Click="BtnOpenScriptEditor_Click" ToolTip="Mở bảng kịch bản trực quan &amp; chỉnh sửa từng bước kịch bản macro" />
                                </Grid>

                                <TextBlock Grid.Row="2" Text="Chuỗi phím Macro và kịch bản (Script):" FontFamily="Consolas" Foreground="{StaticResource CyberTextSecondary}" Margin="0,0,0,4" />
                                <TextBox x:Name="TxtMacroKeystrokes" Grid.Row="3" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Padding="6" Background="{StaticResource CyberInput}" Foreground="{StaticResource CyberTextPrimary}" BorderBrush="{StaticResource CyberBorderDim}" TextChanged="TxtMacroKeystrokes_TextChanged" Margin="0,0,0,8" />
                                <Border Grid.Row="4" Background="#0B1C28" BorderBrush="{StaticResource CyberBorderDim}" BorderThickness="1" CornerRadius="2" Padding="8,6">
                                    <TextBlock Text="Cú pháp hỗ trợ Jitbit: MOUSE_CLICK, MOUSE_DBLCLICK, MOUSE_WHEEL, KEY_PRESS, DELAY hoặc token {Ctrl+C}, {ENTER}."
                                               FontFamily="Consolas" FontSize="10.5" Foreground="{StaticResource CyberNeonCyan}" TextWrapping="Wrap" />
                                </Border>
                            </Grid>

                            <!-- ACTION TYPE: CHANGE CASE (Gợi ý 14) -->
                            <Grid x:Name="PanelChangeCase" Visibility="Collapsed">
                                <StackPanel Margin="0,5,0,0">
                                    <TextBlock Text="Action type : Change text case" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource CyberNeonCyan}" Margin="0,0,0,10" FontSize="13" />
                                    <TextBlock Text="Chế độ chuyển đổi chữ hoa / chữ thường văn bản đang chọn:" FontFamily="Consolas" Foreground="{StaticResource CyberTextSecondary}" Margin="0,0,0,4" />
                                    <ComboBox x:Name="CmbChangeCaseMode" Height="26" FontFamily="Consolas" SelectionChanged="CmbChangeCaseMode_SelectionChanged" Margin="0,0,0,12">
                                        <ComboBoxItem Content="🔠 VIẾT HOA TOÀN BỘ (UPPERCASE)" Tag="UPPERCASE" IsSelected="True" />
                                        <ComboBoxItem Content="🔡 viết thường toàn bộ (lowercase)" Tag="lowercase" />
                                        <ComboBoxItem Content="🔤 Viết Hoa Chữ Đầu Mỗi Từ (Title Case)" Tag="TitleCase" />
                                        <ComboBoxItem Content="📝 Viết hoa đầu câu (Sentence case)" Tag="SentenceCase" />
                                        <ComboBoxItem Content="🔀 ĐẢO NGƯỢC HOA/thường (tOGGLE cASE)" Tag="ToggleCase" />
                                        <ComboBoxItem Content="🔄 Xoay vòng (lowercase ➔ UPPER ➔ Title)" Tag="CycleCase" />
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <!-- ACTION TYPE: OTHER ACTIONS FALLBACK -->
