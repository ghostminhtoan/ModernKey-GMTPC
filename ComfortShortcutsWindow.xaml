<Window x:Class="ModernKey.ComfortShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Keyboard Shortcuts Settings - [Comfort Keys default CsActions.cka]"
        Height="780" Width="1180" MinWidth="950" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CyberBlack}" Foreground="{StaticResource CyberTextPrimary}"
        Icon="Resources/AppIcon.ico">

    <Window.Resources>
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#0078D7" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#0078D7" />
        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF" />
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Row 0: Menu Bar -->
            <RowDefinition Height="Auto" />
            <!-- Row 1: Toolbar Actions -->
            <RowDefinition Height="Auto" />
            <!-- Row 2: Info Banner -->
            <RowDefinition Height="Auto" />
            <!-- Row 3: Main Split Content (Left Tree + Right Visual Keyboard & Inspector) -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0" Background="{StaticResource CyberDark}" Foreground="{StaticResource CyberTextPrimary}" FontFamily="Consolas">
            <MenuItem Header="File">
                <MenuItem Header="Mở Profile (.cka / .json)..." Click="BtnOpenProfile_Click" />
                <MenuItem Header="Lưu Profile (Save)" Click="BtnSaveProfile_Click" />
                <MenuItem Header="Xuất danh sách (Export)..." Click="BtnExportProfile_Click" />
                <Separator Background="{StaticResource CyberBorderDim}" />
                <MenuItem Header="↩ Khôi phục bản sao lưu trước (Restore Backup)..." Click="BtnRestoreBackup_Click" />
                <MenuItem Header="🔄 Khôi phục mặc định (Restore Defaults)..." Click="BtnRestoreDefaults_Click" />
                <Separator Background="{StaticResource CyberBorderDim}" />
                <MenuItem Header="Đóng cửa sổ" Click="BtnClose_Click" />
            </MenuItem>
            <MenuItem Header="Edit">
                <MenuItem Header="Thêm phím tắt mới" Click="BtnAddShortcut_Click" />
                <MenuItem Header="Đổi tổ hợp phím (Change Key Combination)..." Click="BtnChangeCombination_Click" />
                <MenuItem Header="Nhân bản (Copy)" Click="BtnCopyShortcut_Click" />
                <MenuItem Header="Xóa (Delete)" Click="BtnDeleteShortcut_Click" />
            </MenuItem>
            <MenuItem Header="Help">
                <MenuItem Header="Hướng dẫn Comfort Keys..." Click="BtnHelpBanner_Click" />
                <MenuItem Header="Giới thiệu Comfort Shortcuts GMTPC..." Click="BtnAbout_Click" />
            </MenuItem>
        </Menu>

        <!-- Toolbar Actions -->
        <Border Grid.Row="1" Background="{StaticResource CyberPanel}" BorderBrush="{StaticResource CyberBorderDim}"
                BorderThickness="0,0,0,1" Padding="8,5">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="👤 Profile:" VerticalAlignment="Center" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource CyberNeonCyan}" Margin="0,0,6,0" />
                <ComboBox x:Name="CmbProfiles" Width="110" Height="28" Margin="0,0,8,0" FontFamily="Consolas" SelectionChanged="CmbProfiles_SelectionChanged" ToolTip="Chọn cấu hình phím tắt (Profile Switcher)" />

                <Button Content="📂 Open" Click="BtnOpenProfile_Click" Height="28" Padding="10,2" Margin="0,0,6,0" FontFamily="Consolas" ToolTip="Mở file cấu hình profile" />
                <Button Content="💾 Save" Click="BtnSaveProfile_Click" Height="28" Padding="10,2" Margin="0,0,6,0" Background="#1D2A1F" BorderBrush="#00FF66" Foreground="#00FF66" FontFamily="Consolas" FontWeight="Bold" ToolTip="Lưu lại toàn bộ phím tắt" />
                <Button Content="↩ Backup" Click="BtnRestoreBackup_Click" Height="28" Padding="8,2" Margin="0,0,6,0" FontFamily="Consolas" ToolTip="Khôi phục lại file backup tự động gần nhất" />
                <Button Content="📤 Export" Click="BtnExportProfile_Click" Height="28" Padding="10,2" Margin="0,0,12,0" FontFamily="Consolas" ToolTip="Xuất danh sách phím tắt ra file" />

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="0,2,12,2" />

                <Button Content="⌨ Change Key" Click="BtnChangeCombination_Click" Height="28" Padding="10,2" Margin="0,0,6,0"
                        Background="#101E2E" BorderBrush="{StaticResource CyberNeonCyan}" Foreground="{StaticResource CyberNeonCyan}" FontFamily="Consolas" FontWeight="Bold" ToolTip="Đổi phím tắt cho mục đang chọn" />
                <Button Content="📋 Copy" Click="BtnCopyShortcut_Click" Height="28" Padding="10,2" Margin="0,0,6,0" FontFamily="Consolas" ToolTip="Nhân bản mục phím tắt" />
                <Button Content="❌ Delete" Click="BtnDeleteShortcut_Click" Height="28" Padding="10,2" Margin="0,0,12,0"
                        Background="#2B0914" BorderBrush="{StaticResource CyberNeonPink}" Foreground="{StaticResource CyberNeonPink}" FontFamily="Consolas" ToolTip="Xóa phím tắt đang chọn" />

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="0,2,12,2" />

                <Button Content="🔄 Reset Defaults" Click="BtnRestoreDefaults_Click" Height="28" Padding="10,2" Margin="0,0,12,0"
                        Background="#2B2008" BorderBrush="{StaticResource CyberNeonYellow}" Foreground="{StaticResource CyberNeonYellow}" FontFamily="Consolas" FontWeight="Bold" ToolTip="Khôi phục danh sách phím tắt mặc định" />

                <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="0,2,12,2" />

                <Button Content="❓ Help" Click="BtnHelpBanner_Click" Width="55" Height="28" FontFamily="Consolas" ToolTip="Trợ giúp" />
            </StackPanel>
        </Border>

        <!-- Info Banner (Mô tả chi tiết phân biệt Left/Right control keys chuẩn Comfort Keys Pro) -->
        <Border Grid.Row="2" Background="#0A1826" BorderBrush="{StaticResource CyberNeonCyan}" BorderThickness="1"
                CornerRadius="2" Margin="10,8,10,6" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="ℹ" FontSize="18" FontWeight="Bold" Foreground="{StaticResource CyberNeonCyan}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="It is important to know that when you specify keyboard shortcuts, the left and right control keys (Shift, Ctrl, Alt or Win) are processed differently. If you want to use only right Shift, Ctrl, Alt or Win in a keyboard shortcut, press the right keys. If you want to use both right and left keys, press the left keys."
                           FontSize="11" FontFamily="Consolas, Segoe UI" Foreground="{StaticResource CyberTextPrimary}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Main Content (Left TreeView + Right Top Virtual Keyboard & Bottom Inspector) -->
        <Grid Grid.Row="3" Margin="10,4,10,10">
            <Grid.ColumnDefinitions>
                <!-- Cột trái: Cây danh mục phím tắt -->
                <ColumnDefinition Width="280" MinWidth="220" MaxWidth="400" />
                <ColumnDefinition Width="6" />
                <!-- Cột phải: Bàn phím ảo + Inspector cấu hình -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- CỘT TRÁI: Category & Shortcut TreeView -->
            <Border Grid.Column="0" Background="{StaticResource CyberPanel}" BorderBrush="{StaticResource CyberBorderDim}" BorderThickness="1" CornerRadius="2">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource CyberDark}" Padding="8,6" BorderBrush="{StaticResource CyberBorderDim}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="[DANH MỤC PHÍM TẮT]" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource CyberNeonCyan}" Margin="0,0,0,5" />
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtSearch" Grid.Column="0" Height="24" VerticalContentAlignment="Center" FontFamily="Consolas" FontSize="11" Padding="4,0" Background="{StaticResource CyberInput}" Foreground="{StaticResource CyberTextPrimary}" BorderBrush="{StaticResource CyberBorderDim}" TextChanged="TxtSearch_TextChanged" ToolTip="Tìm theo phím tắt, nhãn hoặc lệnh..." />
                                <Button Grid.Column="1" Content="✕" Click="BtnClearSearch_Click" Width="24" Height="24" Margin="2,0,0,0" FontFamily="Consolas" ToolTip="Xóa tìm kiếm" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- TreeView hiển thị phân cấp danh mục -->
                    <TreeView x:Name="TvShortcuts" Grid.Row="1" Background="Transparent" BorderThickness="0"
                              Foreground="{StaticResource CyberTextPrimary}" FontFamily="Consolas"
                              SelectedItemChanged="TvShortcuts_SelectedItemChanged">
                        <TreeView.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#0078D7" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#0078D7" />
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF" />
                        </TreeView.Resources>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="{x:Type TreeViewItem}">
                                <Setter Property="IsExpanded" Value="True" />
                                <Setter Property="Foreground" Value="{StaticResource CyberTextPrimary}" />
                                <Setter Property="Padding" Value="4,3" />
                                <Style.Resources>
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#0078D7" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#0078D7" />
                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF" />
                                </Style.Resources>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#0078D7" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsSelected" Value="True" />
                                            <Condition Property="IsSelectionActive" Value="False" />
                                        </MultiTrigger.Conditions>
                                        <Setter Property="Background" Value="#0078D7" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </MultiTrigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>

                    <!-- Nút thêm/xóa nhanh ở đáy Tree -->
                    <Border Grid.Row="2" Background="{StaticResource CyberDark}" Padding="6,5" BorderBrush="{StaticResource CyberBorderDim}" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="+ Thêm mới" Click="BtnAddShortcut_Click" Margin="0,0,4,0" Height="24" FontFamily="Consolas" Background="#1D2A1F" BorderBrush="#00FF66" Foreground="#00FF66" FontWeight="Bold" />
                            <Button Grid.Column="1" Content="X Xóa" Click="BtnDeleteShortcut_Click" Margin="4,0,0,0" Height="24" FontFamily="Consolas" Background="#2B0914" BorderBrush="{StaticResource CyberNeonPink}" Foreground="{StaticResource CyberNeonPink}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Grid Splitter -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- CỘT PHẢI: Bàn phím ảo trực quan (Trên) + Bảng cấu hình Inspector (Dưới) -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <!-- Phía trên: Visual Interactive Keyboard Map -->
                    <RowDefinition Height="250" MinHeight="180" MaxHeight="340" />
                    <RowDefinition Height="6" />
                    <!-- Phía dưới: Action Detail Inspector -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 1. BÀN PHÍM ẢO TRỰC QUAN (Visual Interactive Keyboard Map) -->
                <Border Grid.Row="0" Background="{StaticResource CyberPanel}" BorderBrush="{StaticResource CyberNeonCyan}" BorderThickness="1" CornerRadius="2" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="[BÀN PHÍM TRỰC QUAN - VISUAL SHORTCUT MAPPER]" FontSize="11" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource CyberNeonCyan}" Margin="0,0,0,4" />

                        <!-- Khung bố trí toàn bộ keycap -->
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="PnlVirtualKeyboard" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Sẽ được populate tự động các hàng phím bằng code-behind -->
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Grid Splitter dọc -->
                <GridSplitter Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="Transparent" />

                <!-- 2. BẢNG CẤU HÌNH THUỘC TÍNH CHI TIẾT (Action Detail Inspector) -->
                <Border Grid.Row="2" Background="{StaticResource CyberPanel}" BorderBrush="{StaticResource CyberBorderDim}" BorderThickness="1" CornerRadius="2" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <!-- Cột trái thuộc tính chung -->
                            <ColumnDefinition Width="290" />
                            <ColumnDefinition Width="16" />
                            <!-- Cột phải cấu hình động theo Action Type -->
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Cột trái: Thuộc tính chung -->
                        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,4,0">
                                <!-- Enable Checkbox & Conflict Warning -->
                                <CheckBox x:Name="ChkShortcutEnabled" Content="✔ Kích hoạt phím tắt này" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource CyberNeonGreen}" Margin="0,0,0,6" Checked="ChkShortcutEnabled_Changed" Unchecked="ChkShortcutEnabled_Changed" ToolTip="Bật hoặc tạm thời vô hiệu hóa phím tắt này" />

                                <!-- Panel cảnh báo xung đột phím tắt -->
                                <Border x:Name="PnlConflictWarning" Visibility="Collapsed" Background="#2B1008" BorderBrush="{StaticResource CyberNeonYellow}" BorderThickness="1" CornerRadius="2" Padding="6,4" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="⚠️" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="TxtConflictWarning" Grid.Column="1" Text="Cảnh báo: Trùng lặp tổ hợp phím!" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource CyberNeonYellow}" TextWrapping="Wrap" />
                                    </Grid>
                                </Border>

                                <!-- Key combination -->
                                <TextBlock Text="Key combination:" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource CyberNeonYellow}" Margin="0,0,0,3" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtKeyCombination" Grid.Column="0" Height="26" VerticalContentAlignment="Center" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource CyberNeonYellow}" Background="{StaticResource CyberInput}" BorderBrush="{StaticResource CyberBorderDim}" IsReadOnly="True" />
                                    <Button Grid.Column="1" Content="⌨" Click="BtnChangeCombination_Click" Width="30" Height="26" Margin="4,0,0,0" FontFamily="Segoe UI Symbol" ToolTip="Nhấn tổ hợp phím mới" />
                                </Grid>

                                <!-- Action type -->
                                <TextBlock Text="Action type:" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource CyberNeonCyan}" Margin="0,0,0,3" />
                                <ComboBox x:Name="CmbActionType" Height="26" Margin="0,0,0,8" SelectionChanged="CmbActionType_SelectionChanged" FontFamily="Consolas" />

                                <!-- Active Scope -->
                                <TextBlock Text="Active in:" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource CyberTextSecondary}" Margin="0,0,0,3" />
                                <ComboBox x:Name="CmbActiveScope" Height="26" Margin="0,0,0,8" FontFamily="Consolas" SelectionChanged="CommonField_Changed">
                                    <ComboBoxItem Content="In all screen modes" IsSelected="True" />
                                    <ComboBoxItem Content="Only in desktop mode" />
                                    <ComboBoxItem Content="Disabled in full screen games" />
                                </ComboBox>

                                <!-- Target App Filter (Gợi ý 15) -->
                                <TextBlock Text="Target application:" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource CyberTextSecondary}" Margin="0,0,0,3" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtTargetApp" Grid.Column="0" Height="26" VerticalContentAlignment="Center" FontFamily="Consolas" FontSize="11" TextChanged="TxtTargetApp_TextChanged" Background="{StaticResource CyberInput}" BorderBrush="{StaticResource CyberBorderDim}" ToolTip="Để trống nếu áp dụng cho mọi phần mềm, hoặc nhập tên exe (vd: chrome, code, notepad)" />
                                    <Button Grid.Column="1" Content="🎯" Click="BtnSelectTargetApp_Click" Width="30" Height="26" Margin="4,0,0,0" FontFamily="Segoe UI Symbol" ToolTip="Chọn ứng dụng đang chạy làm mục tiêu" />
                                </Grid>

                                <!-- Sound -->
                                <TextBlock Text="Sound:" FontFamily="Consolas" Foreground="{StaticResource CyberTextSecondary}" Margin="0,0,0,3" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtSoundPath" Grid.Column="0" Height="26" VerticalContentAlignment="Center" FontFamily="Consolas" TextChanged="TxtSoundPath_TextChanged" Background="{StaticResource CyberInput}" BorderBrush="{StaticResource CyberBorderDim}" />
                                    <Button Grid.Column="1" Content="..." Click="BtnBrowseSound_Click" Width="30" Height="26" Margin="4,0,0,0" ToolTip="Chọn file âm thanh (.wav)" />
                                </Grid>

                                <!-- Label -->
                                <TextBlock Text="Label:" FontFamily="Consolas" Foreground="{StaticResource CyberTextSecondary}" Margin="0,0,0,3" />
                                <TextBox x:Name="TxtLabel" Height="26" VerticalContentAlignment="Center" FontFamily="Consolas" Margin="0,0,0,10" TextChanged="TxtLabel_TextChanged" Background="{StaticResource CyberInput}" BorderBrush="{StaticResource CyberBorderDim}" />

                                <!-- Thống kê sử dụng & Thời gian (Gợi ý 5) -->
                                <Border Background="{StaticResource CyberDark}" BorderBrush="{StaticResource CyberBorderDim}" BorderThickness="1" CornerRadius="2" Padding="6,5" Margin="0,0,0,4">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Trigger count:" FontFamily="Consolas" FontSize="10.5" Foreground="{StaticResource CyberTextSecondary}" />
                                            <TextBlock x:Name="TxtTriggerCount" Grid.Column="1" Text="0 lần" FontFamily="Consolas" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource CyberNeonGreen}" />
                                        </Grid>
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Last used:" FontFamily="Consolas" FontSize="10.5" Foreground="{StaticResource CyberTextSecondary}" />
                                            <TextBlock x:Name="TxtLastUsed" Grid.Column="1" Text="Never" FontFamily="Consolas" FontSize="10.5" Foreground="{StaticResource CyberNeonCyan}" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Last changed:" FontFamily="Consolas" FontSize="10.5" Foreground="{StaticResource CyberTextSecondary}" />
                                            <TextBlock x:Name="TxtLastChanged" Grid.Column="1" Text="-" FontFamily="Consolas" FontSize="10.5" Foreground="{StaticResource CyberNeonPink}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <Separator Grid.Column="1" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />

                        <!-- Cột phải: Cấu hình động theo từng Action Type (Đợt 1 đến Đợt 5) -->
                        <Grid Grid.Column="2">
                            <!-- ACTION TYPE 1: RUN PROGRAM (Đợt 2) -->
                            <Grid x:Name="PanelRunProgram" Visibility="Visible">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Action type : Run program" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource CyberNeonCyan}" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="1" Text="Program, folder or document name (each item in a separate line):" FontFamily="Consolas" Foreground="{StaticResource CyberTextSecondary}" Margin="0,0,0,4" />

                                <TextBox x:Name="TxtRunProgramPaths" Grid.Row="2" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Padding="6" Background="{StaticResource CyberInput}" Foreground="{StaticResource CyberTextPrimary}" BorderBrush="{StaticResource CyberBorderDim}" TextChanged="TxtRunProgramPaths_TextChanged" Margin="0,0,0,8" />

                                <Grid Grid.Row="3" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Start in folder:" VerticalAlignment="Center" FontFamily="Consolas" Foreground="{StaticResource CyberTextSecondary}" Margin="0,0,8,0" />
                                    <TextBox x:Name="TxtRunStartInFolder" Grid.Column="1" Height="26" VerticalContentAlignment="Center" FontFamily="Consolas" TextChanged="TxtRunStartInFolder_TextChanged" Background="{StaticResource CyberInput}" BorderBrush="{StaticResource CyberBorderDim}" />
                                </Grid>

                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="CmbRunAddApp" Grid.Column="0" Width="210" Height="26" FontFamily="Consolas" SelectionChanged="CmbRunAddApp_SelectionChanged">
                                        <ComboBoxItem Content="➕ Add App / File..." IsSelected="True" />
                                        <ComboBoxItem Content="📁 Select File..." Tag="FILE" />
                                        <ComboBoxItem Content="📂 Select Folder..." Tag="FOLDER" />
                                    </ComboBox>
                                    <CheckBox x:Name="ChkRunSwitchAlreadyLaunched" Grid.Column="1" Content="Switch to the already launched program" VerticalAlignment="Center" Margin="14,0,0,0" FontFamily="Consolas" Checked="ChkRunSwitchAlreadyLaunched_Changed" Unchecked="ChkRunSwitchAlreadyLaunched_Changed" />
                                </Grid>
                            </Grid>

                            <!-- ACTION TYPE 2: OPEN URL (Đợt 3) -->
                            <Grid x:Name="PanelOpenUrl" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Text="Action type : Open URL" FontWeight="Bold" FontFamily="Consolas" Foreground="{StaticResource CyberNeonCyan}" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="1" Text="Open URL (to open a number of them, enter each address in a separate line):" FontFamily="Consolas" Foreground="{StaticResource CyberTextSecondary}" Margin="0,0,0,4" />

