                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Add..." Click="BtnUrlAdd_Click" Width="80" Height="26" FontFamily="Consolas" Background="#1D2A1F" BorderBrush="#00FF66" Foreground="#00FF66" FontWeight="Bold" />
                                    <TextBlock Grid.Column="2" Text="Type of URL opening:" VerticalAlignment="Center" FontFamily="Consolas" Foreground="{StaticResource CyberTextSecondary}" Margin="0,0,8,0" />
