<Window x:Class="ModernKey.MacroQuickListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Run"
        Height="420" Width="620" MinWidth="480" MinHeight="320"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        PreviewKeyDown="Window_PreviewKeyDown"
        Deactivated="Window_Deactivated">

    <!-- Cyberpunk Window Container -->
    <Border Background="{StaticResource CyberDark}" BorderBrush="{StaticResource CyberNeonCyan}"
            BorderThickness="1.5" CornerRadius="3" Padding="14">
        <Border.Effect>
            <DropShadowEffect Color="#00F0FF" BlurRadius="12" ShadowDepth="0" Opacity="0.45" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- 0. Title bar -->
                <RowDefinition Height="Auto" />
                <!-- 1. Description / Notice -->
                <RowDefinition Height="Auto" />
                <!-- 2. Search / Input Box -->
                <RowDefinition Height="Auto" />
                <!-- 3. Macro List -->
                <RowDefinition Height="*" />
                <!-- 4. Bottom Toolbar (Counter & Actions) -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 0. Title Bar (Draggable) -->
            <Grid Grid.Row="0" Margin="0,0,0,8" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Icon Run / Macro -->
                    <Border Width="20" Height="20" Background="#180424" BorderBrush="{StaticResource CyberNeonPink}"
                            BorderThickness="1" CornerRadius="2" Margin="0,0,8,0">
                        <TextBlock Text="⚡" FontSize="11" Foreground="{StaticResource CyberNeonYellow}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Run // Quick-List Macro" FontWeight="Bold" FontFamily="Consolas, Segoe UI"
                               Foreground="{StaticResource CyberNeonCyan}" FontSize="13" VerticalAlignment="Center" />
                    <TextBlock Text=" [Win+Space]" FontFamily="Consolas" Foreground="{StaticResource CyberTextDim}"
                               FontSize="11" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>

                <Button Grid.Column="1" Content="✕" Click="BtnClose_Click" Width="24" Height="22"
                        Background="#2B0914" BorderBrush="{StaticResource CyberNeonPink}" Foreground="{StaticResource CyberNeonPink}"
                        FontFamily="Consolas" FontWeight="Bold" FontSize="11" ToolTip="Đóng (Esc)" />
            </Grid>

            <!-- 1. Description text (Comfort Keys Pro style) -->
            <TextBlock Grid.Row="1" Text="Nhập từ khóa viết tắt để lọc nhanh, nhấn Enter để Paste hoặc Shift+Enter để Sequence Key:"
                       FontSize="11" FontFamily="Segoe UI, Tahoma" Foreground="{StaticResource CyberTextSecondary}" Margin="0,0,0,8" TextWrapping="Wrap" />

            <!-- 2. Search Box Row -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Open:" VerticalAlignment="Center" FontFamily="Consolas"
                           FontWeight="Bold" Foreground="{StaticResource CyberNeonCyan}" FontSize="13" Margin="0,0,10,0" />

                <Border Grid.Column="1" Background="{StaticResource CyberInput}" BorderBrush="{StaticResource CyberBorderDim}"
                        BorderThickness="1" CornerRadius="2">
                    <Grid>
                        <TextBox x:Name="TxtSearch" Height="28" BorderThickness="0" Background="Transparent"
                                 Foreground="{StaticResource CyberNeonYellow}" FontFamily="Consolas" FontSize="13" FontWeight="Bold"
                                 VerticalContentAlignment="Center" Padding="8,0" TextChanged="TxtSearch_TextChanged"
                                 PreviewKeyDown="TxtSearch_PreviewKeyDown" />
                        <!-- Nút Xóa nhanh ô tìm kiếm -->
                        <Button x:Name="BtnClearSearch" Content="✕" Click="BtnClearSearch_Click" Width="20" Height="20"
                                HorizontalAlignment="Right" Margin="0,0,4,0" Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource CyberTextDim}" FontSize="10" ToolTip="Xóa bộ lọc"
                                Visibility="Collapsed" />
                    </Grid>
                </Border>
            </Grid>

            <!-- 3. Macro List DataGrid -->
            <Border Grid.Row="3" Background="{StaticResource CyberInput}" BorderBrush="{StaticResource CyberBorderDim}"
                    BorderThickness="1" CornerRadius="2" Margin="0,0,0,10">
                <DataGrid x:Name="DgMacroList" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                          Background="Transparent" Foreground="{StaticResource CyberTextPrimary}"
                          BorderThickness="0" HeadersVisibility="Column" RowHeight="26"
                          RowBackground="{StaticResource CyberDark}" AlternatingRowBackground="{StaticResource CyberPanel}"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource CyberBorderDim}"
                          SelectionMode="Single" SelectionUnit="FullRow" IsReadOnly="True"
                          MouseDoubleClick="DgMacroList_MouseDoubleClick"
                          PreviewKeyDown="DgMacroList_PreviewKeyDown">

                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#101420" />
                            <Setter Property="Foreground" Value="{StaticResource CyberNeonCyan}" />
                            <Setter Property="FontFamily" Value="Consolas" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="Padding" Value="8,4" />
                            <Setter Property="BorderBrush" Value="{StaticResource CyberBorderDim}" />
                            <Setter Property="BorderThickness" Value="0,0,1,1" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>

                    <DataGrid.Columns>
                        <!-- Cột Từ viết tắt (Keyword) -->
                        <DataGridTextColumn Header="TỪ VIẾT TẮT" Binding="{Binding Shortcut}" Width="160">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Consolas" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="Foreground" Value="{StaticResource CyberNeonCyan}" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="8,0" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Cột Cụm từ thay thế (Replacement Snippet) -->
                        <DataGridTextColumn Header="CỤM TỪ THAY THẾ (NỘI DUNG MACRO)" Binding="{Binding Replacement}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Consolas" />
                                    <Setter Property="Foreground" Value="{StaticResource CyberTextPrimary}" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Padding" Value="8,0" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- 4. Bottom Toolbar (Counter & Buttons: Paste, Sequence Key, Add, Edit) -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <!-- Counter: 93 / 1424 -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Spacer -->
                    <ColumnDefinition Width="*" />
                    <!-- Action Buttons -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Counter: x / y -->
                <Border Grid.Column="0" Background="#141824" BorderBrush="{StaticResource CyberBorderDim}"
                        BorderThickness="1" CornerRadius="2" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtCount" Text="0 / 0" FontFamily="Consolas" FontWeight="Bold"
                               Foreground="{StaticResource CyberNeonYellow}" FontSize="12" />
                </Border>

                <!-- Action buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Paste Button -->
                    <Button x:Name="BtnPaste" Click="BtnPaste_Click" Margin="0,0,6,0" Padding="12,5"
                            Background="#16291C" BorderBrush="#00FF66" Foreground="#00FF66"
                            ToolTip="Dán nội dung macro vào ứng dụng qua Clipboard (Enter)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋 " FontSize="11" />
                            <TextBlock Text="Paste" FontWeight="Bold" FontFamily="Consolas" />
                        </StackPanel>
                    </Button>

                    <!-- Sequence Key Button (Yêu cầu đặc thù của người dùng) -->
                    <Button x:Name="BtnSequenceKey" Click="BtnSequenceKey_Click" Margin="0,0,6,0" Padding="12,5"
                            Background="#0E1E2C" BorderBrush="{StaticResource CyberNeonCyan}" Foreground="{StaticResource CyberNeonCyan}"
                            ToolTip="Gõ phím tuần tự từng ký tự vào ứng dụng (Shift+Enter)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌨ " FontSize="11" />
                            <TextBlock Text="Sequence Key" FontWeight="Bold" FontFamily="Consolas" />
                        </StackPanel>
                    </Button>

                    <!-- Add Button -->
                    <Button x:Name="BtnAdd" Click="BtnAdd_Click" Margin="0,0,6,0" Padding="12,5"
                            Background="#181824" BorderBrush="{StaticResource CyberNeonYellow}" Foreground="{StaticResource CyberNeonYellow}"
                            ToolTip="Thêm từ gõ tắt mới (+ Add)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕ " FontSize="11" Foreground="#00FF66" />
                            <TextBlock Text="Add" FontWeight="Bold" FontFamily="Consolas" />
                        </StackPanel>
                    </Button>

                    <!-- Edit Button -->
                    <Button x:Name="BtnEdit" Click="BtnEdit_Click" Padding="12,5"
                            Background="#221424" BorderBrush="{StaticResource CyberNeonPink}" Foreground="{StaticResource CyberNeonPink}"
                            ToolTip="Chỉnh sửa từ gõ tắt đang chọn">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✏ " FontSize="11" />
                            <TextBlock Text="Edit" FontWeight="Bold" FontFamily="Consolas" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
