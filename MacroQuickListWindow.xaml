<Window x:Class="ModernKey.MacroQuickListWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quick-List Macro"
        Height="290" Width="560" MinWidth="420" MinHeight="200"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="CanResizeWithGrip">

    <!-- Cyberpunk Window Container -->
    <Border Background="{StaticResource CyberDark}" BorderBrush="{StaticResource CyberNeonCyan}"
            BorderThickness="1.5" CornerRadius="3" Padding="10">
        <Border.Effect>
            <DropShadowEffect Color="#00F0FF" BlurRadius="12" ShadowDepth="0" Opacity="0.45" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <!-- 0. Header (Title bar / Drag area) -->
                <RowDefinition Height="22" />
                <!-- 1. Two-Column Body (Left: Shortcuts List, Right: Content Preview) -->
                <RowDefinition Height="*" />
                <!-- 2. Bottom Toolbar (Counter & Action Buttons) -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 0. Header Bar (Draggable) -->
            <Grid Grid.Row="0" Margin="0,0,0,6" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="16" Height="16" Background="#180424" BorderBrush="{StaticResource CyberNeonPink}"
                            BorderThickness="1" CornerRadius="2" Margin="0,0,6,0">
                        <TextBlock Text="⚡" FontSize="10" Foreground="{StaticResource CyberNeonYellow}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Quick-List Macro" FontWeight="Bold" FontFamily="Consolas, Segoe UI"
                               Foreground="{StaticResource CyberNeonCyan}" FontSize="12" VerticalAlignment="Center" />
                    <TextBlock Text="[Win+Space]" FontFamily="Consolas" Foreground="{StaticResource CyberTextDim}"
                               FontSize="10" VerticalAlignment="Center" Margin="6,0,0,0" />
                </StackPanel>

                <Button Grid.Column="1" Content="✕" Click="BtnClose_Click" Focusable="False" Width="20" Height="18"
                        Background="#2B0914" BorderBrush="{StaticResource CyberNeonPink}" Foreground="{StaticResource CyberNeonPink}"
                        FontFamily="Consolas" FontWeight="Bold" FontSize="10" ToolTip="Đóng (Esc)" />
            </Grid>

            <!-- 1. Two-Column Layout (Chuẩn Comfort Keys Pro template) -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <!-- Cột trái: Danh sách từ viết tắt -->
                    <ColumnDefinition Width="190" MinWidth="140" MaxWidth="280" />
                    <!-- Cột phải: Khung xem trước nội dung -->
                    <ColumnDefinition Width="*" MinWidth="180" />
                </Grid.ColumnDefinitions>

                <!-- Cột trái: ListBox từ viết tắt (Ảo hóa siêu nhanh, không lag) -->
                <Border Grid.Column="0" Background="#101420" BorderBrush="{StaticResource CyberBorderDim}"
                        BorderThickness="1" CornerRadius="2">
                    <ListBox x:Name="LstShortcuts" Background="Transparent" BorderThickness="0"
                             SelectionMode="Single" Focusable="False"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             MouseDoubleClick="LstShortcuts_MouseDoubleClick"
                             SelectionChanged="LstShortcuts_SelectionChanged">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,3" />
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="FontFamily" Value="Consolas, Segoe UI" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground" Value="{StaticResource CyberNeonCyan}" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                                    BorderThickness="0" CornerRadius="2" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#1A2438" />
                                                    <Setter Property="Foreground" Value="#00F0FF" />
                                                </Trigger>
                                                <!-- Khi chọn: Nền xanh hoàng gia Comfort Keys Pro #0078D7, chữ trắng sắc nét tuyệt đối không che -->
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#0078D7" />
                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Shortcut}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <!-- Cột phải: Xem trước nội dung cụm từ thay thế của mục đang chọn -->
                <Border Grid.Column="1" Background="#101420" BorderBrush="{StaticResource CyberBorderDim}"
                        BorderThickness="1" CornerRadius="2" Margin="6,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="TxtPreview" Text="{Binding SelectedItem.Replacement, ElementName=LstShortcuts}"
                                   Foreground="#E0E6ED" FontFamily="Consolas, Segoe UI" FontSize="12"
                                   TextWrapping="Wrap" Padding="8" />
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- 2. Bottom Toolbar (Counter & Action Buttons) -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <!-- Counter: 93 / 1424 -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Spacer -->
                    <ColumnDefinition Width="*" />
                    <!-- Action Buttons -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Counter: x / y -->
                <Border Grid.Column="0" Background="#141824" BorderBrush="{StaticResource CyberBorderDim}"
                        BorderThickness="1" CornerRadius="2" Padding="8,3" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtCount" Text="0 / 0" FontFamily="Consolas" FontWeight="Bold"
                               Foreground="{StaticResource CyberNeonYellow}" FontSize="11" />
                </Border>

                <!-- Action buttons (Focusable="False" để không cướp tiêu điểm của ứng dụng đang gõ) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Paste Button -->
                    <Button x:Name="BtnPaste" Click="BtnPaste_Click" Focusable="False" Margin="0,0,5,0" Padding="10,4"
                            Background="#14261B" BorderBrush="#00FF66" Foreground="#00FF66"
                            ToolTip="Dán nội dung macro vào ứng dụng (Enter hoặc click)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋 " FontSize="11" />
                            <TextBlock Text="Paste" FontWeight="Bold" FontFamily="Consolas" FontSize="11" />
                        </StackPanel>
                    </Button>

                    <!-- Sequence Key Button -->
                    <Button x:Name="BtnSequenceKey" Click="BtnSequenceKey_Click" Focusable="False" Margin="0,0,5,0" Padding="10,4"
                            Background="#0E1E2C" BorderBrush="{StaticResource CyberNeonCyan}" Foreground="{StaticResource CyberNeonCyan}"
                            ToolTip="Gõ phím tuần tự từng ký tự vào ứng dụng (Shift+Enter)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⌨ " FontSize="11" />
                            <TextBlock Text="Sequence Key" FontWeight="Bold" FontFamily="Consolas" FontSize="11" />
                        </StackPanel>
                    </Button>

                    <!-- Add Button -->
                    <Button x:Name="BtnAdd" Click="BtnAdd_Click" Focusable="False" Margin="0,0,5,0" Padding="10,4"
                            Background="#181824" BorderBrush="{StaticResource CyberNeonYellow}" Foreground="{StaticResource CyberNeonYellow}"
                            ToolTip="Thêm từ gõ tắt mới (+ Add)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕ " FontSize="11" Foreground="#00FF66" />
                            <TextBlock Text="Add" FontWeight="Bold" FontFamily="Consolas" FontSize="11" />
                        </StackPanel>
                    </Button>

                    <!-- Edit Button -->
                    <Button x:Name="BtnEdit" Click="BtnEdit_Click" Focusable="False" Padding="10,4"
                            Background="#221424" BorderBrush="{StaticResource CyberNeonPink}" Foreground="{StaticResource CyberNeonPink}"
                            ToolTip="Chỉnh sửa từ gõ tắt đang chọn">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✏ " FontSize="11" />
                            <TextBlock Text="Edit" FontWeight="Bold" FontFamily="Consolas" FontSize="11" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
