<Window x:Class="ModernKey.AudioDeviceOsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ModernKey Audio Device OSD"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Focusable="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        SizeToContent="WidthAndHeight">
    <Border x:Name="RootBorder" Background="#E61E1E1E" CornerRadius="6" BorderThickness="1"
            BorderBrush="#44FFFFFF" Opacity="0" Padding="20,9" Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="2" Opacity="0.85" />
        </Border.Effect>
        <TextBlock x:Name="TxtDeviceName" Text="Speakers (2- High Definition Audio Device)"
                   FontFamily="Segoe UI, Consolas, Arial" FontWeight="Bold" FontSize="16"
                   Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center" />
    </Border>
</Window>
