<Window x:Class="ModernKey.VolumeOsdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ModernKey Volume OSD"
        Height="48" Width="720"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Focusable="False"
        ResizeMode="NoResize"
        ShowActivated="False">
    <Border x:Name="RootBorder" Background="#E6101010" CornerRadius="4" BorderThickness="1"
            BorderBrush="#33FFFFFF" Opacity="0" Padding="20,7">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="2" Opacity="0.8" />
        </Border.Effect>
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Biểu tượng tam giác âm lượng phong cách Comfort Keys Pro -->
            <Grid Grid.Column="0" Width="76" Height="28" VerticalAlignment="Center" Margin="0,0,24,0">
                <!-- Tam giác vuông: góc dưới trái (0,28), góc dưới phải (76,28), đỉnh trên phải (76,0) -->
                <Polygon x:Name="VolumeTriangle"
                         Points="0,28 76,28 76,0"
                         Stroke="White"
                         StrokeThickness="3"
                         StrokeLineJoin="Round"
                         Fill="Transparent" />
                <!-- Vạch gạch chéo khi Muted -->
                <Line x:Name="MuteSlash"
                      X1="0" Y1="0" X2="76" Y2="28"
                      Stroke="#FF4D4D"
                      StrokeThickness="3.5"
                      StrokeStartLineCap="Round"
                      StrokeEndLineCap="Round"
                      Visibility="Collapsed" />
            </Grid>

            <!-- 25 Vạch hiển thị mức âm lượng (mỗi vạch tương ứng 4%) -->
            <StackPanel x:Name="VolumeBarsContainer" Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Left">
                <!-- Các vạch sẽ được sinh và cập nhật tự động trong code-behind -->
            </StackPanel>
        </Grid>
    </Border>
</Window>
