<Window x:Class="ModernKey.EditClipboardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Clipboard"
        Height="540" Width="580" MinWidth="460" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CyberBlack}"
        Foreground="{StaticResource CyberTextPrimary}"
        ShowInTaskbar="False"
        ResizeMode="CanResizeWithGrip"
        Icon="Resources/AppIcon.ico"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <!-- 0. Header -->
            <RowDefinition Height="Auto" />
            <!-- 1. Form fields (Shortcut, Name, Color) -->
            <RowDefinition Height="Auto" />
            <!-- 2. Content Editor (Text) -->
            <RowDefinition Height="*" />
            <!-- 3. Actions (OK / Cancel) -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0. Header -->
        <Border Grid.Row="0" Background="{StaticResource CyberDark}" CornerRadius="2" Padding="10,7" Margin="0,0,0,10"
                BorderBrush="{StaticResource CyberBorderDim}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="✏ " FontSize="14" Foreground="{StaticResource CyberNeonYellow}" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtHeaderTitle" Text="EDIT CLIPBOARD // CHỈNH SỬA MỤC CLIPBOARD" FontSize="11" FontWeight="Bold" FontFamily="Consolas"
                               Foreground="{StaticResource CyberNeonCyan}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="TxtItemId" Text="[ID]" FontSize="10" FontFamily="Consolas"
                           Foreground="{StaticResource CyberTextDim}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- 1. Metadata Form -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">
            <!-- 1.1 Key Combination (Shortcut) -->
            <Border Background="{StaticResource CyberPanel}" BorderBrush="{StaticResource CyberBorderDim}" BorderThickness="1" CornerRadius="2" Padding="8" Margin="0,0,0,8">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Key combination:" FontWeight="Bold" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource CyberNeonCyan}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" x:Name="TxtShortcutPreview" Text="(None)" FontWeight="Bold" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource CyberNeonYellow}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="ChkCtrl" Content="Ctrl" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource CyberTextPrimary}" Margin="0,0,12,0" VerticalAlignment="Center" Checked="ShortcutInput_Changed" Unchecked="ShortcutInput_Changed" />
                        <CheckBox x:Name="ChkAlt" Content="Alt" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource CyberTextPrimary}" Margin="0,0,12,0" VerticalAlignment="Center" Checked="ShortcutInput_Changed" Unchecked="ShortcutInput_Changed" />
                        <CheckBox x:Name="ChkShift" Content="Shift" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource CyberTextPrimary}" Margin="0,0,12,0" VerticalAlignment="Center" Checked="ShortcutInput_Changed" Unchecked="ShortcutInput_Changed" />
                        <CheckBox x:Name="ChkWin" Content="Windows" FontFamily="Consolas" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource CyberTextPrimary}" Margin="0,0,16,0" VerticalAlignment="Center" Checked="ShortcutInput_Changed" Unchecked="ShortcutInput_Changed" />

                        <!-- Ô nhập Key -->
                        <TextBlock Text="Key:" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CyberNeonCyan}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <Border Background="{StaticResource CyberInput}" BorderBrush="{StaticResource CyberBorderDim}" BorderThickness="1" CornerRadius="2" Width="65" Height="24" Margin="0,0,8,0">
                            <TextBox x:Name="TxtKey" BorderThickness="0" Background="Transparent" Foreground="{StaticResource CyberNeonYellow}"
                                     FontFamily="Consolas" FontSize="11" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                     PreviewKeyDown="TxtKey_PreviewKeyDown" TextChanged="TxtKey_TextChanged" ToolTip="Nhấp vào đây và nhấn phím bạn muốn gán (Ví dụ: H, F1, 1...)" />
                        </Border>

                        <!-- Nút Xóa Shortcut -->
                        <Button x:Name="BtnClearShortcut" Content="✕ Xóa" Click="BtnClearShortcut_Click" Padding="6,2" FontSize="10" FontFamily="Consolas"
                                Background="#1A1520" BorderBrush="#885566" Foreground="#FF88AA" Margin="0,0,0,0" ToolTip="Hủy bỏ phím tắt này" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- 1.2 Name & Background Color -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="2.5*" />
                </Grid.ColumnDefinitions>

                <!-- Name Field -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Name:" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CyberNeonCyan}" Margin="0,0,0,4" />
                    <Border Background="{StaticResource CyberInput}" BorderBrush="{StaticResource CyberBorderDim}" BorderThickness="1" CornerRadius="2">
                        <TextBox x:Name="TxtName" Height="26" BorderThickness="0" Background="Transparent"
                                 Foreground="{StaticResource CyberTextPrimary}" FontFamily="Consolas" FontSize="12"
                                 VerticalContentAlignment="Center" Padding="6,0" />
                    </Border>
                </StackPanel>

                <!-- Background Color Field -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Background color:" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CyberNeonCyan}" Margin="0,0,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Dropdown mẫu màu -->
                        <ComboBox x:Name="CmbColors" Grid.Column="0" Height="26" SelectionChanged="CmbColors_SelectionChanged"
                                  Background="#10141E" Foreground="{StaticResource CyberTextPrimary}" FontFamily="Consolas" FontSize="11">
                            <ComboBoxItem Tag="Default">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="14" Height="14" Background="Transparent" BorderBrush="#55657E" BorderThickness="1" Margin="0,0,6,0" />
                                    <TextBlock Text="Default (Mặc định)" />
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="#556B2F">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="14" Height="14" Background="#556B2F" CornerRadius="1" Margin="0,0,6,0" />
                                    <TextBlock Text="Olive Green" />
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="#1B5E20">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="14" Height="14" Background="#1B5E20" CornerRadius="1" Margin="0,0,6,0" />
                                    <TextBlock Text="Forest Green" />
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="#00695C">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="14" Height="14" Background="#00695C" CornerRadius="1" Margin="0,0,6,0" />
                                    <TextBlock Text="Slate Teal" />
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="#1565C0">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="14" Height="14" Background="#1565C0" CornerRadius="1" Margin="0,0,6,0" />
                                    <TextBlock Text="Ocean Blue" />
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="#00838F">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="14" Height="14" Background="#00838F" CornerRadius="1" Margin="0,0,6,0" />
                                    <TextBlock Text="Cyber Cyan" />
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="#4A148C">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="14" Height="14" Background="#4A148C" CornerRadius="1" Margin="0,0,6,0" />
                                    <TextBlock Text="Deep Purple" />
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="#880E4F">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="14" Height="14" Background="#880E4F" CornerRadius="1" Margin="0,0,6,0" />
                                    <TextBlock Text="Magenta Pink" />
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="#B71C1C">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="14" Height="14" Background="#B71C1C" CornerRadius="1" Margin="0,0,6,0" />
                                    <TextBlock Text="Crimson Red" />
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="#D84315">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="14" Height="14" Background="#D84315" CornerRadius="1" Margin="0,0,6,0" />
                                    <TextBlock Text="Rust Orange" />
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="#F57F17">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="14" Height="14" Background="#F57F17" CornerRadius="1" Margin="0,0,6,0" />
                                    <TextBlock Text="Amber Gold" />
                                </StackPanel>
                            </ComboBoxItem>
                            <ComboBoxItem Tag="#263238">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="14" Height="14" Background="#263238" CornerRadius="1" Margin="0,0,6,0" />
                                    <TextBlock Text="Dark Slate" />
                                </StackPanel>
                            </ComboBoxItem>
                        </ComboBox>

                        <!-- Nút Bảng màu chuẩn Win32 (ColorDialog) -->
                        <Button x:Name="BtnPickCustomColor" Grid.Column="1" Content="..." Click="BtnPickCustomColor_Click"
                                Margin="4,0,0,0" Padding="8,2" Height="26" FontFamily="Consolas" FontWeight="Bold"
                                ToolTip="Mở bảng pha màu chi tiết (Color Dialog)" />
                    </Grid>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- 2. Text Content Editor (Chỉ hiển thị cho văn bản) -->
        <Grid Grid.Row="2" x:Name="GridContentEditor" Margin="0,0,0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Nội dung văn bản (Content):" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CyberNeonCyan}" VerticalAlignment="Center" />
                <CheckBox Grid.Column="1" x:Name="ChkWordWrap" Content="Word wrap" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource CyberTextSecondary}"
                          IsChecked="True" Checked="ChkWordWrap_Checked" Unchecked="ChkWordWrap_Unchecked" VerticalAlignment="Center" />
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource CyberInput}" BorderBrush="{StaticResource CyberBorderDim}" BorderThickness="1" CornerRadius="2">
                <TextBox x:Name="TxtContent" Background="Transparent" BorderThickness="0"
                         Foreground="{StaticResource CyberTextPrimary}" FontFamily="Consolas" FontSize="12"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="8" />
            </Border>
        </Grid>

        <!-- Thông báo ảnh/tệp không sửa được nội dung văn bản -->
        <Border Grid.Row="2" x:Name="BrdNonTextNotice" Background="{StaticResource CyberPanel}" BorderBrush="{StaticResource CyberBorderDim}" BorderThickness="1" CornerRadius="2" Padding="14" Margin="0,0,0,10" Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="ℹ MỤC HÌNH ẢNH HOẶC TỆP TIN" FontWeight="Bold" FontFamily="Consolas" FontSize="13" Foreground="{StaticResource CyberNeonYellow}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                <TextBlock Text="Bạn có thể gán Tên gợi nhớ (Name), Phím tắt (Key combination), và Màu sắc (Background color) cho mục này."
                           TextWrapping="Wrap" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource CyberTextSecondary}" HorizontalAlignment="Center" TextAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 3. Actions OK & Cancel -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="[Enter = Lưu | Esc = Hủy]" FontFamily="Consolas" FontSize="10"
                       Foreground="{StaticResource CyberTextSecondary}" VerticalAlignment="Center" />

            <Button Grid.Column="1" x:Name="BtnOk" Content="OK (LƯU)" Click="BtnOk_Click" Width="95" Margin="0,0,8,0"
                    Background="#16291C" BorderBrush="#00FF66" Foreground="#00FF66" FontWeight="Bold" />
            <Button Grid.Column="2" x:Name="BtnCancel" Content="CANCEL (HỦY)" Click="BtnCancel_Click" Width="105"
                    Background="#24141E" BorderBrush="{StaticResource CyberNeonPink}" Foreground="{StaticResource CyberNeonPink}" />
        </Grid>
    </Grid>
</Window>
