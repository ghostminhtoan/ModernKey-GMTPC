<Window x:Class="ModernKey.CustomInputMethodWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KIỂU GÕ TỰ ĐỊNH NGHĨA // OPENKEY CYBER"
        Height="580" Width="580"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource CyberBlack}"
        Foreground="{StaticResource CyberTextPrimary}"
        ResizeMode="NoResize"
        Icon="Resources/AppIcon.ico">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Presets Group -->
            <RowDefinition Height="Auto" />
            <!-- Define Keys & Rules Table Group -->
            <RowDefinition Height="*" />
            <!-- Bottom Footer Actions -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource CyberDark}" CornerRadius="3" Padding="12,10" Margin="0,0,0,12"
                BorderBrush="{StaticResource CyberNeonCyan}" BorderThickness="1.2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="KIỂU GÕ TỰ ĐỊNH NGHĨA" FontSize="16" FontWeight="ExtraBold"
                               Foreground="{StaticResource CyberNeonCyan}" FontFamily="Consolas, Segoe UI">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="#00F0FF" BlurRadius="6" ShadowDepth="0" Opacity="0.75" />
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="USER DEFINED INPUT METHOD // 33 ACTIONS PORT FROM OPENKEY C++"
                               FontSize="10" Foreground="{StaticResource CyberNeonYellow}" FontFamily="Consolas" Margin="0,2,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="#180424" BorderBrush="{StaticResource CyberNeonPink}"
                        BorderThickness="1" CornerRadius="2" Padding="8,4" VerticalAlignment="Center">
                    <TextBlock Text="CUSTOM ENGINE" FontSize="11" FontWeight="Bold" FontFamily="Consolas"
                               Foreground="{StaticResource CyberNeonPink}" />
                </Border>
            </Grid>
        </Border>

        <!-- Presets Group -->
        <Border Grid.Row="1" Background="{StaticResource CyberDark}" CornerRadius="3" Padding="12,10" Margin="0,0,0,12"
                BorderBrush="{StaticResource CyberBorderDim}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="[KIỂU GÕ SẴN CÓ]" FontWeight="Bold" FontFamily="Consolas"
                           Foreground="{StaticResource CyberNeonCyan}" Margin="0,0,0,8" />
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="CmbPresets" Grid.Column="0" Margin="0,0,10,0" />
                    <Button x:Name="BtnLoadPreset" Grid.Column="1" Content="NẠP KIỂU GÕ NÀY"
                            Padding="12,6" Click="BtnLoadPreset_Click" />
                </Grid>
            </Grid>
        </Border>

        <!-- Define Keys & Rules Table Group -->
        <Border Grid.Row="2" Background="{StaticResource CyberDark}" CornerRadius="3" Padding="12,10" Margin="0,0,0,12"
                BorderBrush="{StaticResource CyberBorderDim}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="[ĐỊNH NGHĨA PHÍM &amp; QUY TẮC]" FontWeight="Bold" FontFamily="Consolas"
                           Foreground="{StaticResource CyberNeonCyan}" Margin="0,0,0,10" />

                <!-- Input Row -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="65" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="PHÍM:" VerticalAlignment="Center" Margin="0,0,8,0"
                               FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource CyberNeonCyan}" />
                    <TextBox x:Name="TxtKey" Grid.Column="1" MaxLength="1" TextAlignment="Center"
                             FontFamily="Consolas" FontWeight="Bold" FontSize="14" Margin="0,0,14,0" />
                    <TextBlock Grid.Column="2" Text="DÙNG CHO:" VerticalAlignment="Center" Margin="0,0,8,0"
                               FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource CyberNeonCyan}" />
                    <ComboBox x:Name="CmbAction" Grid.Column="3" />
                </Grid>

                <!-- Action Buttons Row -->
                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Button x:Name="BtnAdd" Content="THÊM" Margin="0,0,8,0" Padding="16,5" Click="BtnAdd_Click" />
                        <Button x:Name="BtnReplace" Content="THAY THẾ" Margin="0,0,8,0" Padding="16,5" Click="BtnReplace_Click" />
                    </StackPanel>
                    <Button x:Name="BtnDelete" Grid.Column="1" Content="XOÁ" Padding="16,5" Click="BtnDelete_Click"
                            BorderBrush="{StaticResource CyberNeonPink}" Foreground="{StaticResource CyberNeonPink}" />
                </Grid>

                <!-- Rules DataGrid -->
                <DataGrid x:Name="DgRules" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False"
                          Background="{StaticResource CyberInput}" Foreground="{StaticResource CyberTextPrimary}"
                          BorderBrush="{StaticResource CyberBorderDim}" HeadersVisibility="Column"
                          RowBackground="{StaticResource CyberDark}" AlternatingRowBackground="{StaticResource CyberPanel}"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource CyberBorderDim}"
                          SelectionMode="Single" IsReadOnly="True"
                          SelectionChanged="DgRules_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PHÍM" Binding="{Binding DisplayKey}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="FontFamily" Value="Consolas" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="Foreground" Value="{StaticResource CyberNeonCyan}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="DÙNG CHO (HÀNH ĐỘNG)" Binding="{Binding ActionName}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Footer Actions -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Nhấn vào hàng để chọn phím và hành động tương ứng"
                       FontSize="11" Foreground="{StaticResource CyberTextDim}" VerticalAlignment="Center" FontFamily="Consolas" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="BtnSave" Content="LƯU CẤU HÌNH" Padding="18,7" Click="BtnSave_Click"
                        Background="#1D2A1F" BorderBrush="#00FF66" Foreground="#00FF66" Margin="0,0,8,0" />
                <Button x:Name="BtnClose" Content="ĐÓNG" Padding="18,7" Click="BtnClose_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
