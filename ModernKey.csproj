<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>ModernKey</AssemblyName>
    <RootNamespace>ModernKey</RootNamespace>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>ModernKey.App</StartupObject>
    <Deterministic>true</Deterministic>
    <Prefer32Bit>false</Prefer32Bit>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Buffers" Version="4.6.1" />
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\AppIcon.ico" />
    <Resource Include="Resources\StatusViet.ico" />
    <Resource Include="Resources\StatusEng.ico" />
    <None Update="Resources\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\StatusViet.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\StatusEng.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <Target Name="OrganizePortableBin" AfterTargets="Build">
    <MakeDir Directories="$(TargetDir).portable\bin" Condition="!Exists('$(TargetDir).portable\bin')" />

    <ItemGroup>
      <_LooseDlls Include="$(TargetDir)*.dll" />
      <_LoosePdbs Include="$(TargetDir)*.pdb" Exclude="$(TargetDir)$(TargetName).pdb" />
    </ItemGroup>

    <!-- Copy loose DLLs to .portable\bin and remove from root -->
    <Copy SourceFiles="@(_LooseDlls)" DestinationFolder="$(TargetDir).portable\bin" SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true" Condition="'@(_LooseDlls)' != ''" />
    <Delete Files="@(_LooseDlls)" Condition="'@(_LooseDlls)' != ''" />

    <!-- Copy dependency PDBs to .portable\bin and remove from root -->
    <Copy SourceFiles="@(_LoosePdbs)" DestinationFolder="$(TargetDir).portable\bin" SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true" Condition="'@(_LoosePdbs)' != ''" />
    <Delete Files="@(_LoosePdbs)" Condition="'@(_LoosePdbs)' != ''" />
  </Target>

</Project>
