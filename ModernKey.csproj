<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>ModernKey</AssemblyName>
    <RootNamespace>ModernKey</RootNamespace>
    <ApplicationIcon>Resources\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>ModernKey.App</StartupObject>
    <Deterministic>true</Deterministic>
    <Prefer32Bit>false</Prefer32Bit>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Buffers" Version="4.6.1" />
    <PackageReference Include="System.Memory" Version="4.6.3" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
    <PackageReference Include="Sdcb.PaddleOCR" Version="3.3.1" />
    <PackageReference Include="Sdcb.PaddleOCR.Models.Online" Version="3.3.1" />
    <PackageReference Include="OpenCvSharp4.Windows" Version="4.9.0.20240103" />
    <PackageReference Include="Sdcb.PaddleInference.runtime.win64.mkl" Version="3.3.1.70" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\AppIcon.ico" />
    <Resource Include="Resources\StatusViet.ico" />
    <Resource Include="Resources\StatusEng.ico" />
    <None Update="Resources\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\StatusViet.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Resources\StatusEng.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <Target Name="OrganizePortableBin" AfterTargets="Build">
    <MakeDir Directories="$(TargetDir).portable\bin" Condition="!Exists('$(TargetDir).portable\bin')" />
    <MakeDir Directories="$(TargetDir).portable\bin\x64" Condition="!Exists('$(TargetDir).portable\bin\x64')" />
    <MakeDir Directories="$(TargetDir).portable\bin\x86" Condition="!Exists('$(TargetDir).portable\bin\x86')" />

    <ItemGroup>
      <_LooseDlls Include="$(TargetDir)*.dll" />
      <_LoosePdbs Include="$(TargetDir)*.pdb" Exclude="$(TargetDir)$(TargetName).pdb" />
      <_DllDirFiles Include="$(TargetDir)dll\**\*.*" />
      <_DllX64Files Include="$(TargetDir)dll\x64\*.*" />
    </ItemGroup>

    <!-- Copy loose DLLs to .portable\bin and remove from root -->
    <Copy SourceFiles="@(_LooseDlls)" DestinationFolder="$(TargetDir).portable\bin" SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true" Condition="'@(_LooseDlls)' != ''" />
    <Delete Files="@(_LooseDlls)" Condition="'@(_LooseDlls)' != ''" />

    <!-- Copy dependency PDBs to .portable\bin and remove from root -->
    <Copy SourceFiles="@(_LoosePdbs)" DestinationFolder="$(TargetDir).portable\bin" SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true" Condition="'@(_LoosePdbs)' != ''" />
    <Delete Files="@(_LoosePdbs)" Condition="'@(_LoosePdbs)' != ''" />

    <!-- Copy native files from dll\x64\ to both .portable\bin\ and .portable\bin\x64\ -->
    <Copy SourceFiles="@(_DllX64Files)" DestinationFolder="$(TargetDir).portable\bin" SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true" Condition="'@(_DllX64Files)' != ''" />
    <Copy SourceFiles="@(_DllDirFiles)" DestinationFiles="@(_DllDirFiles->'$(TargetDir).portable\bin\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" OverwriteReadOnlyFiles="true" Condition="'@(_DllDirFiles)' != ''" />

    <!-- Remove original dll\ directory from output root -->
    <RemoveDir Directories="$(TargetDir)dll" Condition="Exists('$(TargetDir)dll')" />
  </Target>

</Project>
