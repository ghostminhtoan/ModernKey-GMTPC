<Window x:Class="ModernKey.KeyCombinationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Key Combination" Height="500" Width="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource CyberBlack}" Foreground="{StaticResource CyberTextPrimary}"
        Icon="Resources/AppIcon.ico"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Tiêu đề hướng dẫn -->
        <TextBlock Grid.Row="0" Text="Nhấn tổ hợp phím trên bàn phím HOẶC bấm chọn trực tiếp bên dưới:"
                   FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{StaticResource CyberNeonCyan}" Margin="0,0,0,8" />

        <!-- Ô hiển thị tổ hợp phím đang gán -->
        <Border Grid.Row="1" Background="{StaticResource CyberDark}" BorderBrush="{StaticResource CyberNeonYellow}"
                BorderThickness="2" CornerRadius="4" Padding="12" Margin="0,0,0,10">
            <Grid>
                <TextBlock x:Name="TxtCombination" Text="[ Đang chờ phím... ]" FontSize="20" FontWeight="ExtraBold"
                           FontFamily="Consolas" Foreground="{StaticResource CyberNeonYellow}"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#FFE600" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                    </TextBlock.Effect>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Tùy chọn phân biệt phím trái phải -->
        <CheckBox x:Name="ChkDistinguishLeftRight" Grid.Row="2" Content="Phân biệt phím trái / phải (Left/Right Shift, Ctrl, Alt, Win)"
                  FontFamily="Consolas" FontSize="11" Margin="0,0,0,10" Checked="ChkDistinguishLeftRight_Checked" Unchecked="ChkDistinguishLeftRight_Checked" />

        <!-- Bộ chọn phím trực quan (Quick Key Selector Palette) -->
        <Border Grid.Row="3" Background="{StaticResource CyberPanel}" BorderBrush="{StaticResource CyberBorderDim}"
                BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Vertical">
                    <!-- 1. Modifiers Toggles -->
                    <TextBlock Text="1. Phím bổ trợ (Modifiers):" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CyberNeonCyan}" Margin="0,0,0,4" />
                    <WrapPanel Margin="0,0,0,8">
                        <CheckBox x:Name="ChkModCtrl" Content="Ctrl" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource CyberNeonYellow}" Margin="0,0,16,4" Checked="ModifierQuickCheck_Changed" Unchecked="ModifierQuickCheck_Changed" />
                        <CheckBox x:Name="ChkModAlt" Content="Alt" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource CyberNeonYellow}" Margin="0,0,16,4" Checked="ModifierQuickCheck_Changed" Unchecked="ModifierQuickCheck_Changed" />
                        <CheckBox x:Name="ChkModShift" Content="Shift" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource CyberNeonYellow}" Margin="0,0,16,4" Checked="ModifierQuickCheck_Changed" Unchecked="ModifierQuickCheck_Changed" />
                        <CheckBox x:Name="ChkModWin" Content="Win" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource CyberNeonYellow}" Margin="0,0,16,4" Checked="ModifierQuickCheck_Changed" Unchecked="ModifierQuickCheck_Changed" />
                    </WrapPanel>

                    <!-- 2. Function keys F1 - F12 -->
                    <TextBlock Text="2. Phím chức năng (F1 - F12):" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CyberNeonCyan}" Margin="0,0,0,4" />
                    <WrapPanel x:Name="PnlFKeys" Margin="0,0,0,8">
                        <!-- Populated by code or items below -->
                    </WrapPanel>

                    <!-- 3. Top Number keys 0 - 9 -->
                    <TextBlock Text="3. Phím số hàng trên (0 - 9):" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CyberNeonCyan}" Margin="0,0,0,4" />
                    <WrapPanel x:Name="PnlDigitKeys" Margin="0,0,0,8">
                        <!-- Populated by code -->
                    </WrapPanel>

                    <!-- 4. Numpad keys Nm 0 - Nm 9 -->
                    <TextBlock Text="4. Bàn phím số Numpad (Nm 0 - Nm 9):" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CyberNeonCyan}" Margin="0,0,0,4" />
                    <WrapPanel x:Name="PnlNumPadKeys" Margin="0,0,0,8">
                        <!-- Populated by code -->
                    </WrapPanel>

                    <!-- 5. Phím điều khiển thông dụng -->
                    <TextBlock Text="5. Phím điều khiển / Điều hướng:" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="{StaticResource CyberNeonCyan}" Margin="0,0,0,4" />
                    <WrapPanel x:Name="PnlSpecialKeys">
                        <!-- Populated by code -->
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Nút hành động -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="XÓA PHÍM" Click="BtnClear_Click" Width="90" Height="30"
                    Background="#2B0914" BorderBrush="{StaticResource CyberNeonPink}" Foreground="{StaticResource CyberNeonPink}" FontFamily="Consolas" FontWeight="Bold" />
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="HỦY" Click="BtnCancel_Click" Width="80" Height="30" Margin="0,0,8,0" FontFamily="Consolas" />
                <Button Content="ĐỒNG Ý (OK)" Click="BtnOk_Click" Width="120" Height="30"
                        Background="#1D2A1F" BorderBrush="#00FF66" Foreground="#00FF66" FontFamily="Consolas" FontWeight="Bold" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
