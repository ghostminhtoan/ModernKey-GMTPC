<Window x:Class="ModernKey.KeyCombinationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change Key Combination" Height="260" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource CyberBlack}" Foreground="{StaticResource CyberTextPrimary}"
        Icon="Resources/AppIcon.ico" KeyDown="Window_KeyDown" KeyUp="Window_KeyUp">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Nhấn tổ hợp phím bạn muốn gán trên bàn phím:"
                   FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="{StaticResource CyberNeonCyan}" Margin="0,0,0,10" />

        <!-- Ô hiển thị tổ hợp phím đang bấm -->
        <Border Grid.Row="1" Background="{StaticResource CyberDark}" BorderBrush="{StaticResource CyberNeonYellow}"
                BorderThickness="2" CornerRadius="4" Padding="14" Margin="0,0,0,12">
            <Grid>
                <TextBlock x:Name="TxtCombination" Text="[ Đang chờ phím... ]" FontSize="20" FontWeight="ExtraBold"
                           FontFamily="Consolas" Foreground="{StaticResource CyberNeonYellow}"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#FFE600" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                    </TextBlock.Effect>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Tùy chọn phân biệt phím trái phải -->
        <CheckBox x:Name="ChkDistinguishLeftRight" Grid.Row="2" Content="Phân biệt phím trái / phải (Left/Right Shift, Ctrl, Alt, Win)"
                  FontFamily="Consolas" FontSize="11" Margin="0,0,0,14" Checked="ChkDistinguishLeftRight_Checked" Unchecked="ChkDistinguishLeftRight_Checked" />

        <!-- Nút hành động -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="XÓA PHÍM" Click="BtnClear_Click" Width="100" Height="30" Margin="0,0,8,0"
                    Background="#2B0914" BorderBrush="{StaticResource CyberNeonPink}" Foreground="{StaticResource CyberNeonPink}" FontFamily="Consolas" FontWeight="Bold" />
            <Button Content="HỦY" Click="BtnCancel_Click" Width="80" Height="30" Margin="0,0,8,0" FontFamily="Consolas" />
            <Button Content="ĐỒNG Ý (OK)" Click="BtnOk_Click" Width="120" Height="30"
                    Background="#1D2A1F" BorderBrush="#00FF66" Foreground="#00FF66" FontFamily="Consolas" FontWeight="Bold" />
        </StackPanel>
    </Grid>
</Window>
