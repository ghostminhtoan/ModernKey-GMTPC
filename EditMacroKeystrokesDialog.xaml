<Window x:Class="ModernKey.EditMacroKeystrokesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Macro" Height="500" Width="680"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource CyberBlack}" Foreground="{StaticResource CyberTextPrimary}"
        Icon="Resources/AppIcon.ico">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- DataGrid hiển thị các event phím bấm -->
        <DataGrid x:Name="DgMacroEvents" Grid.Row="0" AutoGenerateColumns="False" CanUserAddRows="False"
                  Background="{StaticResource CyberInput}" Foreground="{StaticResource CyberTextPrimary}"
                  BorderBrush="{StaticResource CyberBorderDim}" HeadersVisibility="Column" RowHeight="24"
                  RowBackground="{StaticResource CyberDark}" AlternatingRowBackground="{StaticResource CyberPanel}"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource CyberBorderDim}"
                  SelectionMode="Single" SelectionUnit="FullRow">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Foreground" Value="{StaticResource CyberNeonCyan}" />
                    <Setter Property="Background" Value="{StaticResource CyberDark}" />
                    <Setter Property="FontFamily" Value="Consolas" />
                    <Setter Property="FontWeight" Value="Bold" />
                    <Setter Property="Padding" Value="8,4" />
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <!-- Delay ms -->
                <DataGridTextColumn Header="Delay (ms)" Binding="{Binding Delay}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Consolas" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Padding" Value="6,0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Event: Key Down / Key Up -->
                <DataGridTemplateColumn Header="Event" Width="120">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Event}" FontFamily="Consolas" VerticalAlignment="Center" Padding="6,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Event}" Value="Key Down">
                                                <Setter Property="Foreground" Value="#00FF66" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Event}" Value="Key Up">
                                                <Setter Property="Foreground" Value="{StaticResource CyberNeonPink}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                    <DataGridTemplateColumn.CellEditingTemplate>
                        <DataTemplate>
                            <ComboBox SelectedValue="{Binding Event, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBoxItem Content="Key Down" />
                                <ComboBoxItem Content="Key Up" />
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellEditingTemplate>
                </DataGridTemplateColumn>

                <!-- Key Code & Name -->
                <DataGridTextColumn Header="Key" Binding="{Binding Key}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontFamily" Value="Consolas" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="Padding" Value="6,0" />
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>

                <!-- Extended Key Checkbox -->
                <DataGridCheckBoxColumn Header="Extended" Binding="{Binding Extended}" Width="80" />
            </DataGrid.Columns>
        </DataGrid>

        <!-- Thanh công cụ điều khiển phía dưới -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Nhóm nút thao tác: Add, Delete, Up, Down, More -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="+ Add" Click="BtnAdd_Click" Height="28" Padding="12,3" Margin="0,0,6,0"
                        Background="#1D2A1F" BorderBrush="#00FF66" Foreground="#00FF66" FontFamily="Consolas" FontWeight="Bold" />
                <Button Content="X Delete" Click="BtnDelete_Click" Height="28" Padding="12,3" Margin="0,0,6,0"
                        Background="#2B0914" BorderBrush="{StaticResource CyberNeonPink}" Foreground="{StaticResource CyberNeonPink}" FontFamily="Consolas" />
                <Button Content="↑" Click="BtnMoveUp_Click" Width="32" Height="28" Margin="0,0,6,0" FontFamily="Consolas" FontWeight="Bold" ToolTip="Di chuyển lên" />
                <Button Content="↓" Click="BtnMoveDown_Click" Width="32" Height="28" Margin="0,0,6,0" FontFamily="Consolas" FontWeight="Bold" ToolTip="Di chuyển xuống" />
                <Button Content="..." Click="BtnMoreOptions_Click" Width="32" Height="28" FontFamily="Consolas" ToolTip="Tùy chọn bổ sung" />
            </StackPanel>

            <!-- Nhóm nút hoàn tất: OK, Cancel, Help -->
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <Button Content="OK" Click="BtnOk_Click" Width="80" Height="28" Margin="0,0,6,0"
                        Background="#1D2A1F" BorderBrush="#00FF66" Foreground="#00FF66" FontFamily="Consolas" FontWeight="Bold" />
                <Button Content="Cancel" Click="BtnCancel_Click" Width="80" Height="28" Margin="0,0,6,0" FontFamily="Consolas" />
                <Button Content="Help" Click="BtnHelp_Click" Width="70" Height="28" FontFamily="Consolas" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
